# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# Session cookie transport. Leave unset for the safe default: false in
# development and true in production. Only set false in production for an
# isolated local HTTP test; use HTTPS in every real deployment.
# SESSION_COOKIE_SECURE=false

# Session secret – use a long random string in production
SESSION_SECRET=replace-this-with-a-long-random-secret

# Optional reverse proxy trust. Use only for a known deployment topology.
# TRUST_PROXY=loopback

# Database path (relative to project root)
DB_PATH=./data/trustvault.db

# Rate limiting (all optional — defaults shown)
# Limits are per IP address and use an in-memory store (resets on restart).
# For multi-process deployments, replace the store with a shared Redis store.
#
# Login: max 10 attempts per 15-minute window
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW_MS=900000
#
# Registration: max 5 attempts per 1-hour window
RATE_REGISTER_MAX=5
RATE_REGISTER_WINDOW_MS=3600000
#
# Upload: max 20 attempts per 1-hour window
RATE_UPLOAD_MAX=20
RATE_UPLOAD_WINDOW_MS=3600000
