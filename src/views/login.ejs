<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sign in – TrustVault</title>
</head>
<body>
  <h1>Sign in</h1>
  <% if (typeof error !== 'undefined' && error) { %>
    <p style="color:red;"><%= error %></p>
  <% } %>
  <form method="POST" action="/auth/login" autocomplete="off">
    <label>Email<br>
      <input type="email" name="email" required maxlength="254" />
    </label><br><br>
    <label>Password<br>
      <input type="password" name="password" required maxlength="128" />
    </label><br><br>
    <button type="submit">Sign in</button>
  </form>
  <p><a href="/auth/register">No account? Register</a></p>
</body>
</html>
