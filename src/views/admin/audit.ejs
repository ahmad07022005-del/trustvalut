<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Audit Log – TrustVault Admin</title><link rel="stylesheet" href="/styles.css" /></head>
<body><header class="site-header"><div class="header-inner"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">T</span><span>TrustVault Admin</span></a><div class="header-actions"><span><%= user.email %></span><a href="/documents">Documents</a><a href="/admin/users">Users</a></div></div></header>
<main class="page"><div class="page-heading"><div><h1>Audit log</h1><p class="muted"><%= total %> total events</p></div><a class="button secondary" href="/admin/categories">Categories</a></div>
<section class="card filter-card"><form method="GET" action="/admin/audit" class="filter-grid"><div class="field"><label for="action">Action</label><select id="action" name="action"><option value="">All actions</option><% allowedActions.forEach(a => { %><option value="<%= a %>"<%= filterAction === a ? ' selected' : '' %>><%= a %></option><% }) %></select></div><div class="field"><label for="outcome">Outcome</label><select id="outcome" name="outcome"><option value="">All outcomes</option><% allowedOutcomes.forEach(o => { %><option value="<%= o %>"<%= filterOutcome === o ? ' selected' : '' %>><%= o %></option><% }) %></select></div><div class="field"><label for="actor">Actor ID</label><input id="actor" type="text" name="actor" value="<%= filterActor %>" /></div><div class="field"><label for="from">From</label><input id="from" type="date" name="from" value="<%= filterFrom %>" /></div><div class="field"><label for="to">To</label><input id="to" type="date" name="to" value="<%= filterTo %>" /></div><div class="filter-actions"><button type="submit">Filter</button><a href="/admin/audit">Clear</a></div></form></section>
<section class="card"><% if (events.length === 0) { %><p class="empty-state">No audit events match the current filter.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>ID</th><th>Actor</th><th>Action</th><th>Resource</th><th>Outcome</th><th>Detail</th><th>Occurred at</th></tr></thead><tbody><% events.forEach(e => { %><tr><td><%= e.id %></td><td><%= e.email || (e.actorId ? String(e.actorId) : 'anonymous') %></td><td><%= e.action %></td><td><%= e.resource || '' %></td><td><%= e.outcome %></td><td><%= e.detail || '' %></td><td><%= e.occurredAt %></td></tr><% }) %></tbody></table></div><p class="muted">Page <%= page %> of <%= totalPages %> <% if (page > 1) { %><a href="?page=<%= page - 1 %>&action=<%= filterAction %>&outcome=<%= filterOutcome %>&actor=<%= filterActor %>&from=<%= filterFrom %>&to=<%= filterTo %>">Previous</a><% } %> <% if (page < totalPages) { %><a href="?page=<%= page + 1 %>&action=<%= filterAction %>&outcome=<%= filterOutcome %>&actor=<%= filterActor %>&from=<%= filterFrom %>&to=<%= filterTo %>">Next</a><% } %></p><% } %></section></main></body></html>
