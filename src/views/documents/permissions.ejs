<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Manage access – TrustVault</title><link rel="stylesheet" href="/styles.css" /></head>
<body>
  <header class="site-header"><div class="header-inner"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">T</span><span>TrustVault</span></a><div class="header-actions"><span><%= user.email %></span><a href="/documents">My documents</a></div></div></header>
  <main class="page">
    <div class="page-heading"><div><h1>Manage access</h1><p class="muted">Control who can access <strong><%= doc.title %></strong>.</p></div></div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (success) { %><p class="success" role="status"><%= success %></p><% } %>
    <section class="card" aria-labelledby="grant-title">
      <h2 id="grant-title">Share with someone</h2>
      <p class="muted">Recipients must have an active TrustVault account. No email invitation is sent automatically.</p>
      <form method="POST" action="/documents/<%= doc.docId %>/permissions/grant" autocomplete="off" class="filter-grid">
        <input type="hidden" name="_csrf" value="<%= token %>" />
        <div class="field"><label for="grantee_email">Recipient email</label><input id="grantee_email" type="email" name="grantee_email" required maxlength="254" placeholder="recipient@example.com" /></div>
        <div class="field"><label for="permission">Permission</label><select id="permission" name="permission"><option value="read">Read — preview and download</option><option value="edit">Edit — update metadata</option></select></div>
        <div class="filter-actions"><button type="submit">Grant access</button></div>
      </form>
    </section>
    <section class="card" aria-labelledby="grants-title" style="margin-top:1.25rem">
      <h2 id="grants-title">Current recipients</h2>
      <% if (grants.length === 0) { %><p class="empty-state">No one has access to this document yet.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Recipient</th><th>Permission</th><th>Granted</th><th>Status</th><th>Action</th></tr></thead><tbody>
      <% grants.forEach(g => { %><tr><td><%= g.email %></td><td><%= g.permission === 'edit' ? 'Edit' : 'Read' %></td><td><%= g.grantedAt %></td><td><%= g.active ? 'Active' : 'Revoked' %></td><td><% if (g.active) { %><form method="POST" action="/documents/<%= doc.docId %>/permissions/<%= g.grantId %>/revoke" class="inline-form"><input type="hidden" name="_csrf" value="<%= token %>" /><button type="submit" class="danger">Revoke</button></form><% } %></td></tr><% }) %>
      </tbody></table></div><% } %>
    </section>
  </main>
</body>
</html>
