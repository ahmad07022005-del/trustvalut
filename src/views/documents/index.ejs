<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>My Documents – TrustVault</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">T</span><span>TrustVault</span></a>
      <div class="header-actions">
        <span><%= user.email %></span>
        <form method="POST" action="/auth/logout" class="inline-form"><input type="hidden" name="_csrf" value="<%= token %>" /><button type="submit">Sign out</button></form>
      </div>
    </div>
  </header>
  <main class="page">
    <div class="page-heading">
      <div><h1>My documents</h1><p class="muted">Securely store, find, and share your files.</p></div>
      <div class="actions"><a class="button secondary" href="/documents/shared">Shared with me</a><a class="button" href="/documents/upload">Upload document</a></div>
    </div>
    <section class="card filter-card" aria-labelledby="filter-title">
      <h2 id="filter-title">Find a document</h2>
      <form method="GET" action="/documents" class="filter-grid">
        <div class="field"><label for="q">Title</label><input id="q" type="search" name="q" value="<%= query %>" maxlength="200" placeholder="Search titles" /></div>
        <div class="field"><label for="mime">Type</label><input id="mime" type="text" name="mime" value="<%= mime %>" maxlength="100" placeholder="application/pdf" /></div>
        <div class="field"><label for="category">Category</label><input id="category" type="text" name="category" value="<%= category %>" maxlength="100" placeholder="Category" /></div>
        <div class="field"><label for="from">Uploaded after</label><input id="from" type="date" name="from" value="<%= from %>" /></div>
        <div class="field"><label for="to">Uploaded before</label><input id="to" type="date" name="to" value="<%= to %>" /></div>
        <div class="field"><label for="minSize">Min bytes</label><input id="minSize" type="number" name="minSize" value="<%= minSize ?? '' %>" min="0" /></div>
        <div class="field"><label for="maxSize">Max bytes</label><input id="maxSize" type="number" name="maxSize" value="<%= maxSize ?? '' %>" min="0" /></div>
        <div class="filter-actions"><button type="submit">Apply filters</button><a href="/documents">Clear</a></div>
      </form>
    </section>
    <section class="card" aria-labelledby="results-title">
      <h2 id="results-title">Your files</h2>
      <% if (docs.length === 0) { %><p class="empty-state">No documents matched your filters.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Title</th><th>Description</th><th>Category</th><th>Type</th><th>Size</th><th>Uploaded</th><th>Actions</th></tr></thead><tbody>
      <% docs.forEach(doc => { %><tr><td><strong><%= doc.title %></strong></td><td><%= doc.description %></td><td><%= doc.category || '—' %></td><td><%= doc.mimeType %></td><td><%= Math.ceil(doc.sizeBytes / 1024) %> KB</td><td><%= doc.createdAt %></td><td><div class="actions"><a href="/documents/<%= doc.id %>/download">Download</a><a href="/documents/<%= doc.id %>/preview">Preview</a><a href="/documents/<%= doc.id %>/edit">Edit</a><a href="/documents/<%= doc.id %>/permissions">Manage access</a><form method="POST" action="/documents/<%= doc.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this document? This cannot be undone.');"><input type="hidden" name="_csrf" value="<%= token %>" /><button type="submit" class="danger">Delete</button></form></div></td></tr><% }) %>
      </tbody></table></div><p class="muted">Page <%= page %></p><% } %>
    </section>
  </main>
</body>
</html>
